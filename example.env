# MediaWiki Database Configuration
DB_CONTAINER_NAME=db
DB_NAME=my_wiki
DB_USER=wikiuser
DB_PASSWORD=your-strong-password-here

# MediaWiki Server Configuration
MW_SERVER=http://localhost:8080
# Generate with: openssl rand -hex 32
MW_SECRET_KEY=your-64-character-hex-secret-key-here
# Generate with: openssl rand -hex 8
MW_UPGRADE_KEY=your-16-character-hex-upgrade-key-here
MW_DEBUG=false

# Staging Environment Configuration
STAGING_DB_CONTAINER_NAME=db_staging
STAGING_DB_NAME=my_wiki
STAGING_DB_USER=wikiuser
STAGING_DB_PASSWORD=your-strong-staging-password-here
STAGING_MW_SERVER=http://localhost:8081
# Generate with: openssl rand -hex 32
STAGING_MW_SECRET_KEY=your-64-character-hex-staging-secret-key-here
# Generate with: openssl rand -hex 8
STAGING_MW_UPGRADE_KEY=your-16-character-hex-staging-upgrade-key-here
STAGING_MW_DEBUG=true