  urldate = {2025-11-17},
  abstract = {In this paper we present some solutions developed in the context of our research group to address problems and needs related to working with historical data. Our work is based on an extensive dataset derived from judicial sources from the 16th and 17th centuries preserved in the Vatican Archives. The project aligns two digital approaches. Firstly, building a knowledge base using computational ontologies and graph databases and publishing the open research data following FAIR guidelines. Secondly, developing a set of web apps focusing on network and geospatial analysis, interactive system of archival references and timeline. This is an ongoing and open source project active in the research group "Normative knowledge in the praxis of the Congregation of the Council" at the MPI for Legal History and Legal Theory. Ein Beitrag zur 9. Tagung des Verbands "Digital Humanities im deutschsprachigen Raum" - DHd 2023 Open Humanities Open Culture.},
  keywords = {DHd2023,FAIR data,graph database,historical data,Kontextsetzung,linked data,Modellierung,Netzwerkanalyse,ontologies,Räumliche Analyse,semantic web,Theoretisierung,Visualisierung,visualization}
}

